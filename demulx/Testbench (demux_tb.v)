`timescale 1ns/1ps

module demux_tb;

reg D;
reg [1:0] S;

wire Y0, Y1, Y2, Y3;

demux_1x4 uut(
    .D(D),
    .S(S),
    .Y0(Y0),
    .Y1(Y1),
    .Y2(Y2),
    .Y3(Y3)
);

initial begin

    $display("Time\tS\tD\tY0 Y1 Y2 Y3");
    $monitor("%0t\t%b\t%b\t%b  %b  %b  %b",
              $time,S,D,Y0,Y1,Y2,Y3);

    D = 1;

    S = 2'b00; #10;
    S = 2'b01; #10;
    S = 2'b10; #10;
    S = 2'b11; #10;

    D = 0;

    S = 2'b00; #10;
    S = 2'b01; #10;
    S = 2'b10; #10;
    S = 2'b11; #10;

    $finish;

end

endmodule